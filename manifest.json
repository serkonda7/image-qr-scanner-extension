{
  "manifest_version": 3,
  "name": "Image QR Scanner",
  "description": "Scan QR codes in images from the context menu.",
  "version": "0.2.1",
  "permissions": ["contextMenus", "scripting", "activeTab", "clipboardWrite", "notifications"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Select region to scan QR code"
  },
  "background": {
    "service_worker": "main.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["svg.js"],
      "run_at": "document_start"
    }
  ]
}
